+    assert str(errors[0]) == str(errors[1])
+
+
+@pytest.mark.parametrize("value", [np.nan, np.inf], ids=["nan", "infinity"])
+def test_grouped_consumed_nonfinite_keeps_input_validation_priority(value):
+    a = np.eye(1028)
+    a[16, 16] = -1.
+    a[8, 20] = a[20, 8] = value
