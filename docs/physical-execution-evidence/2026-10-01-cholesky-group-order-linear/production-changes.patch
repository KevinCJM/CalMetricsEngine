+@pytest.mark.parametrize("empty", [False, True])
+def test_empty_consumption_keeps_output_and_workspace_reusable(empty):
+    values = np.empty(0) if empty else finite_values(1025)
+    mask = np.zeros(values.shape, bool)
+    values.setflags(write=False)
+    mask.setflags(write=False)
+    before = values.copy()
+    workspace = op.Workspace()
+    for name, extra in (("median_where", ()), ("quantile_where", (.5,))):
+        owner = np.full(3, 912.)
+        with pytest.raises(ValueError, match="INSUFFICIENT_SAMPLE"):
+            op.call(name, values, mask, *extra, workspace=workspace,
+                    out=owner[1:2].reshape(()), audit=True)
+        np.testing.assert_array_equal(owner, 912.)
+        recovered, audit = op.call(name, np.array([2., 6., 10.]),
+                                   np.array([True, False, True]), *extra,
+                                   workspace=workspace, audit=True)
+        assert_bits(recovered, 6.)
+        assert audit["algorithm_copy_bytes"] == 2 * 8
+    assert_bits(values, before)
+
