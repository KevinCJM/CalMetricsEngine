+    starts=np.array([0],np.int64);ends=np.array([129],np.int64)
+    with AdaptiveScheduler(cpu_budget=1,config=config()) as single:
+        with pytest.raises(ValueError) as reference:single.execute(graph,inputs,starts,ends)
+    with AdaptiveScheduler(cpu_budget=4,config=config()) as parallel:
+        with pytest.raises(ValueError) as actual:parallel.execute(graph,inputs,starts,ends)
